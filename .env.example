# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- APIキーは、ブラウザへの入力ではなくここ（サーバーの環境変数）に設定することを推奨 ---
# 設定済みのキーは画面の「API利用登録」に「サーバーで設定済み」と表示され、ブラウザへの入力は不要です。
# （画面に入力した値がある場合は、入力した値が優先されます）
# 以下は任意(未設定の場合、該当ソースの検索は利用できない/制限される)

# DISCOGS_TOKEN: Discogs APIのパーソナルアクセストークン
DISCOGS_TOKEN=""

# SPOTIFY_CLIENT_ID / SPOTIFY_CLIENT_SECRET: Spotify Web API(Client Credentials)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# RAKUTEN_APP_ID: 楽天ブックスAPIのアプリケーションID
RAKUTEN_APP_ID=""

# PORT: サーバーのポート(省略時は3000)
# PORT=3000

# MB_CONTACT: MusicBrainz APIのUser-Agentに含める連絡先(メールアドレスまたはURL)。未設定時はリポジトリURLを使用
# MB_CONTACT=""

# TRUST_PROXY: リバースプロキシ配下で運用する場合のみ 1 を設定(レート制限のIP判定にX-Forwarded-Forの末尾を使用)
# TRUST_PROXY=1
