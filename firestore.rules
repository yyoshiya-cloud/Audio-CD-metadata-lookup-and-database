rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // アプリ構成情報 (バージョン・更新日など)
    // 開発・運用の利便性のため、このドキュメントのみ読み書きを許可します。
    match /config/appInfo {
      allow read, write: if true;
    }

    // デフォルトはすべて拒否 (セキュリティ確保のため)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
