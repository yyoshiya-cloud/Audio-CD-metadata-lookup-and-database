rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 構成設定コレクション（バージョン情報など）は誰でも読み取り可能、認証済みユーザーは書き込み可能
    match /config/appInfo {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // デフォルトで拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
